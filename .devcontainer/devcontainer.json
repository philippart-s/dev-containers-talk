{	// 03-🧩 Create a feature 🧩
  // Dev Container to do PHP coding
	"name": "PHP Coding",
	"image": "mcr.microsoft.com/devcontainers/base:noble",

	// Port of the PHP built-in web server, forwarded to the host
	"forwardPorts": [8080],

	// Executed commands after container creation
	"postCreateCommand": {
		"PHPStan": "composer global require phpstan/phpstan"
	},

 	// Features added to the image
	"features": {
		"ghcr.io/devcontainers/features/php:1": {
			"version": "8.5"
		},
		"ghcr.io/shyim/devcontainers-features/symfony-cli:0": {},
		"./ovhcloud-cli": {}
	},

	"remoteEnv": {
		// Tools installed with `composer global require`
		"PATH": "${containerEnv:PATH}:/home/vscode/.composer/vendor/bin",
		// Xdebug is installed but off: `XDEBUG_MODE=debug php …` to debug
		"XDEBUG_MODE": "off"
	},

	// IDE customization
	"customizations": {
		"vscode": {
			"settings": {
				"php.validate.executablePath": "/usr/local/php/current/bin/php"
			},
			"extensions": ["bmewburn.vscode-intelephense-client", "xdebug.php-debug"]
		}
	}
}
