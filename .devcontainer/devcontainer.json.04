{	// 04-🐳 Use custom images 🐳

  // Dev Container to do Java coding
	"name": "Java Coding",
	//XX-dockerfile
	// "build": {
	// 	"dockerfile": "Dockerfile"
	// },
	//XX-custom-image
	//"image": "95y036e0.gra7.container-registry.ovh.net/library/dev-container-talk:1.1.0",
	//XX-docker-compose
	"dockerComposeFile": "docker-compose.yml",
	"service": "devcontainer",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

	// Executed commands after container creation
	"postCreateCommand": {
		"Javelit": "jbang app setup && jbang app install javelit@javelit"
	},

 	// Features added to the image
	"features": {
		"ghcr.io/devcontainers/features/java:1": {
      "installMaven": true,
			"mavenVersion": "3.9.14",
      "version": "25",
      "jdkDistro": "tem"
    },
		"ghcr.io/devcontainers-extra/features/jbang-sdkman:2": {
			"jdkDistro": "tem",
			"jdkVersion": "25-tem"
		},
		"ghcr.io/robbert229/devcontainer-features/postgresql-client:1": {}
	},

	// Mandatory to be allow the JBang VSCode extension to run JBang
	"remoteEnv": {
  	"PATH": "${containerEnv:PATH}:/usr/local/sdkman/candidates/jbang/current/bin"
	},

	/// IDE customization
	"customizations": {
		"vscode": {
			"settings": {
				"java.configuration.runtimes": [
					{
						"name": "JavaSE-26",
						"path": "/usr/local/sdkman/candidates/java/current/"
					}
				]
			},
			"extensions": ["jbangdev.jbang-vscode", "vscjava.vscode-java-pack"]
		}
	}
}
