{	// 03-🧩 Create a feature 🧩

  // Dev Container to do Java coding
	"name": "Java Coding",
	"image": "mcr.microsoft.com/devcontainers/base:noble",

	// Executed commands after container creation
	"postCreateCommand": {
		"Javelit": "jbang app setup && jbang app install javelit@javelit"
	},

 	// Features added to the image
	"features": {
		"ghcr.io/devcontainers/features/java:1": {
      "installMaven": true,
			"mavenVersion": "3.9.11",
      "version": "25",
      "jdkDistro": "tem"
    },
		"ghcr.io/devcontainers-extra/features/jbang-sdkman:2": {
			"jdkDistro": "tem",
			"jdkVersion": "25-tem"
		},
		"./slidesk": {}
	},

	// Mandatory to be allow the JBang VSCode extention to run JBang
	"remoteEnv": {
  	"PATH": "${containerEnv:PATH}:/usr/local/sdkman/candidates/jbang/current/bin"
	},

	// IDE customization
	"customizations": {
		"vscode": {
			"settings": {
				"java.configuration.runtimes": [
					{
						"name": "JavaSE-25",
						"path": "/usr/local/sdkman/candidates/java/current/"
					}
				]
			},
			"extensions": ["jbangdev.jbang-vscode"]
		}
	}
}
